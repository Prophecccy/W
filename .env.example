# W Application Environment Variables Template
# Copy this file to .env.local for local development.
# NEVER commit real credentials, tokens, or client secrets to git.
# NEVER put confidential secrets in VITE_* variables (Vite inlines them into client JS).

# ── Client-Safe Public OAuth Identifiers ─────────────────────────
# Web/shared public Google OAuth Client ID
VITE_GOOGLE_CLIENT_ID=your-client-id-here.apps.googleusercontent.com

# Optional dedicated Desktop/Native OAuth Client ID (public PKCE client)
VITE_GOOGLE_DESKTOP_CLIENT_ID=

# ── Vercel Server-Only Variables (Configure in Vercel Dashboard, NOT VITE_*) ──
# Confidential Web OAuth Client ID & Secret used exclusively by /api/auth/*
GOOGLE_CLIENT_ID=your-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-server-only-client-secret

# 32+ byte random secret (e.g. `openssl rand -hex 32`) for AES-256-GCM HttpOnly session cookies
BFF_SESSION_SECRET=replace-with-64-hex-char-random-secret

# Comma-separated exact allowed origins for CORS & redirect validation
ALLOWED_ORIGINS=https://your-app.vercel.app

# Optional HTTPS webhook URL for HIGH/CRITICAL server security alerts (OWASP A09)
SECURITY_ALERT_WEBHOOK_URL=
