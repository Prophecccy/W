# W Application Environment Variables Template
# Copy this file to .env.local for local development.
# NEVER commit real credentials, tokens, or client secrets to git.

# Google OAuth 2.0 Credentials (for Google Drive Sync & Authentication)
# Obtain from Google Cloud Console > APIs & Services > Credentials
VITE_GOOGLE_CLIENT_ID=your-client-id-here.apps.googleusercontent.com

# Desktop client uses PKCE (RFC 7636); client secret is optional and should not be embedded in production.
VITE_GOOGLE_CLIENT_SECRET=
