rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ── Default-Deny Security Posture ────────────────────────────────
    // [ W ] is local-first (IndexedDB + Google Drive W_state.json).
    // Firestore is decommissioned; all direct client reads and writes
    // are explicitly denied to prevent unauthorized access or abuse.
    match /{document=**} {
      allow read, write: if false;
    }

    // ── Reference Template (ONLY if Firestore is ever re-enabled) ────
    // Never use wildcard subcollections (`/{subcollection}/{docId}`) and
    // never allow clients to self-assign roles (`role`, `isAdmin`).
    //
    // match /users/{uid} {
    //   allow read: if request.auth != null
    //               && request.auth.token.firebase.sign_in_provider != 'anonymous'
    //               && request.auth.uid == uid;
    //   allow create, update: if request.auth != null
    //                         && request.auth.uid == uid
    //                         && request.resource.data.keys().hasOnly([
    //                              'uid', 'email', 'displayName', 'settings',
    //                              'aesthetics', 'wallpapers', 'strikes', 'freeze',
    //                              'lockdown', 'lastActiveDate', 'hasOnboarded', 'createdAt'
    //                            ])
    //                         && !request.resource.data.keys().hasAny(['role', 'isAdmin', 'plan']);
    // }
    // match /admin/{docId} {
    //   allow read, write: if request.auth != null && request.auth.token.role == 'admin';
    // }
  }
}
