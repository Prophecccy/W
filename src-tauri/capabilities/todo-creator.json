{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "todo-creator",
  "description": "Least-privilege capability for the floating Todo Creator dialog",
  "windows": ["todo-creator"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "core:window:allow-show",
    "core:window:allow-set-focus"
  ]
}
