{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "W",
  "version": "1.8.2",
  "identifier": "com.wapp.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "W",
        "url": "/",
        "decorations": false,
        "width": 800,
        "height": 600,
        "visible": true
      },
      {
        "label": "sticky-overlay",
        "title": "Sticky Notes",
        "url": "/sticky-canvas",
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "maximized": false,
        "visible": false,
        "skipTaskbar": true,
        "focus": false,
        "focusable": false,
        "alwaysOnTop": false,
        "closable": false,
        "resizable": false
      },
      {
        "label": "widget",
        "title": "Widget",
        "url": "/widget",
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "width": 460,
        "height": 620,
        "minWidth": 300,
        "minHeight": 400,
        "maxWidth": 800,
        "maxHeight": 900,
        "visible": false,
        "skipTaskbar": true,
        "resizable": true,
        "focusable": false,
        "focus": false,
        "alwaysOnTop": false
      },
      {
        "label": "block-overlay",
        "title": "",
        "url": "/block-overlay",
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "visible": false,
        "skipTaskbar": true,
        "resizable": false,
        "alwaysOnTop": true,
        "focus": true,
        "focusable": true,
        "closable": false
      }
    ],

    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**", "$RESOURCE/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/header.bmp",
        "sidebarImage": "icons/sidebar.bmp"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY4NkIyMDI5QUQwM0E4RTcKUldUbnFBT3RLU0JyYU1paE1NMktXWmk2RlFwUjVrNmJ1TWE0dkpmVXgyRnhTaVhBWXN6TTQrakUK",
      "endpoints": [
        "https://github.com/Prophecccy/W/releases/latest/download/latest.json"
      ]
    }
  }
}
